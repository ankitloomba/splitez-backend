# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database (Railway provides DATABASE_URL automatically) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitez?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=2592000

# --- OTP provider (to be wired in splitez-webservices) ---
OTP_PROVIDER=mock
