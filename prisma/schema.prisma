// SplitEZ / Splitezy — data model
// Source of truth: Product Project Blueprint V0.2 §30 (Initial Data Model / Entities)
// The backend is the source of truth for all financial calculations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Users
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(uuid()) @db.Uuid
  phone          String?  @unique
  countryCode    String   @default("+91")
  firstName      String
  lastName       String?
  email          String?  @unique
  passwordHash   String?
  emailVerified  Boolean  @default(false)
  emailVerifyToken   String?  @unique
  emailVerifyExpiry  DateTime?
  passwordResetToken  String?  @unique
  passwordResetExpiry DateTime?
  profilePicture String?
  currency       String   @default("INR")
  isVerified     Boolean  @default(false)
  adFree         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preferences        UserPreferences?
  groupMemberships   GroupMember[]
  tripMemberships    TripMember[]
  relationshipsFrom  Relationship[]   @relation("RelationshipOwner")
  relationshipsTo    Relationship[]   @relation("RelationshipPeer")
  expensesCreated    Expense[]        @relation("ExpenseCreatedBy")
  expensesPaid       Expense[]        @relation("ExpensePaidBy")
  expenseSplits      ExpenseSplit[]
  settlementsFrom    Settlement[]     @relation("SettlementFrom")
  settlementsTo      Settlement[]     @relation("SettlementTo")
  income             Income[]
  personalExpenses   PersonalExpense[]
  activities         Activity[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]

  @@map("users")
}

model UserPreferences {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  navigationOrder       Json     @default("[\"home\",\"groups\",\"trips\",\"finances\",\"more\"]")
  notificationSettings  Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}


// ---------------------------------------------------------------------------
// People & Relationships
// ---------------------------------------------------------------------------

model Relationship {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  peerId    String   @db.Uuid
  createdAt DateTime @default(now())

  owner User @relation("RelationshipOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  peer  User @relation("RelationshipPeer", fields: [peerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, peerId])
  @@map("relationships")
}

// ---------------------------------------------------------------------------
// Groups & Trips (shared expense spaces)
// ---------------------------------------------------------------------------

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  image       String?
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members  GroupMember[]
  expenses Expense[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @db.Uuid
  userId   String   @db.Uuid
  role     String   @default("member") // member | admin
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Trip {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members  TripMember[]
  expenses Expense[]

  @@map("trips")
}

model TripMember {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("trip_members")
}

// ---------------------------------------------------------------------------
// Expenses & Split engine
// Amounts stored in integer minor units (e.g. paise) to avoid float rounding.
// ---------------------------------------------------------------------------

enum SplitMethod {
  EQUAL
  EXACT
  PERCENTAGE
}

model Expense {
  id          String      @id @default(uuid()) @db.Uuid
  description String
  amount      Int // minor units (paise/cents)
  currency    String      @default("INR")
  splitMethod SplitMethod @default(EQUAL)
  category    String?
  note        String?
  receipt     String?
  date        DateTime    @default(now())

  createdById String  @db.Uuid
  paidById    String  @db.Uuid
  groupId     String? @db.Uuid
  tripId      String? @db.Uuid

  // Idempotency key for duplicate-submission protection (§29)
  idempotencyKey String? @unique

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  paidBy    User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  group     Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  trip      Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  splits    ExpenseSplit[]

  @@index([groupId])
  @@index([tripId])
  @@map("expenses")
}

model ExpenseSplit {
  id        String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  userId    String @db.Uuid
  // Owed share of the expense in minor units. Sum of shares == expense.amount.
  shareAmount Int
  // Original percentage (when PERCENTAGE) for auditability, basis points (10000 = 100%)
  percentageBps Int?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@map("expense_splits")
}

// ---------------------------------------------------------------------------
// Settlements
// ---------------------------------------------------------------------------

enum SettlementStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

model Settlement {
  id        String           @id @default(uuid()) @db.Uuid
  fromId    String           @db.Uuid // payer
  toId      String           @db.Uuid // payee
  amount    Int // minor units
  currency  String           @default("INR")
  status    SettlementStatus @default(COMPLETED)
  groupId   String?          @db.Uuid
  note      String?

  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from User @relation("SettlementFrom", fields: [fromId], references: [id])
  to   User @relation("SettlementTo", fields: [toId], references: [id])

  @@map("settlements")
}

// ---------------------------------------------------------------------------
// My Finances (personal, non-shared)
// ---------------------------------------------------------------------------

model Income {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid
  amount Int
  type   String // Salary | Cash | Pocket Money | Bonus | Freelance | Refund | Other
  date   DateTime @default(now())
  note   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("income")
}

model PersonalExpense {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  amount      Int
  description String
  category    String?
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_expenses")
}

// ---------------------------------------------------------------------------
// Activity / Audit, Notifications, Devices
// ---------------------------------------------------------------------------

model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String // EXPENSE_CREATED, SETTLEMENT_COMPLETED, etc.
  entityType String?
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activity")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  type      String
  data      Json     @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String // ios | android
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

// ---------------------------------------------------------------------------
// Config / CMS
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  icon     String?
  isSystem Boolean @default(true)
  ownerId  String? @db.Uuid // null = system category

  @@map("categories")
}

model PromotionalBanner {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  subtitle     String?
  image        String?
  cta          String?
  destination  String?
  targetScreen String
  startDate    DateTime
  endDate      DateTime
  priority     Int       @default(0)
  status       String    @default("Draft") // Draft | Active | Inactive | Expired

  @@map("promotional_banners")
}

// Dashboard elements — flexible CMS blocks rendered by the apps
model DashboardElement {
  id           String   @id @default(uuid()) @db.Uuid
  type         String   // greeting | banner | card | announcement | tip | spotlight
  title        String?
  subtitle     String?
  body         String?  // rich text / markdown
  image        String?
  cta          String?  // call-to-action button text
  destination  String?  // deep-link or URL
  targetScreen String   @default("home")
  position     Int      @default(0) // ordering weight
  config       Json     @default("{}") // flexible key-value (colors, icon, style)
  startDate    DateTime @default(now())
  endDate      DateTime?
  status       String   @default("Draft") // Draft | Active | Inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([targetScreen, status])
  @@map("dashboard_elements")
}

// ---------------------------------------------------------------------------
// Analytics — event tracking, DAU/MAU, user journeys, service health
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  sessionId  String?  // client-generated session ID
  event      String   // app_open, screen_view, action, session_end
  screen     String?  // home, groups, trips, finances, settings …
  action     String?  // tap_create_expense, tap_settle, etc.
  metadata   Json     @default("{}")
  platform   String?  // ios, android, web
  appVersion String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

model ServiceHealthLog {
  id         String   @id @default(uuid()) @db.Uuid
  endpoint   String
  method     String   @default("GET")
  statusCode Int
  duration   Int      // ms
  error      String?
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([endpoint, createdAt])
  @@index([statusCode])
  @@index([createdAt])
  @@map("service_health_logs")
}

// Unique app installs — one row per device, survives re-installs via installId
model AppInstall {
  id          String   @id @default(uuid()) @db.Uuid
  installId   String   @unique // client-generated persistent UUID
  platform    String   // ios | android
  appVersion  String?
  osVersion   String?
  deviceModel String?
  userId      String?  @db.Uuid // linked after login, nullable
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  uninstalled Boolean  @default(false)

  @@index([platform])
  @@index([firstSeen])
  @@index([lastSeen])
  @@map("app_installs")
}

// ---------------------------------------------------------------------------
// Content Pages — privacy, terms, contact, about, etc.
// ---------------------------------------------------------------------------

model ContentPage {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // e.g. "privacy-policy", "terms", "contact-us"
  title       String
  body        String   @db.Text // markdown or HTML content
  category    String   @default("legal") // legal | info | support
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  metaTitle   String?  // SEO / in-app title override
  metaDesc    String?  // SEO description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug, published])
  @@index([category, published])
  @@map("content_pages")
}

// ---------------------------------------------------------------------------
// Ad Placements — server-driven ad configuration
// ---------------------------------------------------------------------------

model AdPlacement {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique // e.g. "home_banner", "expense_list_native", "settings_banner"
  adType       String   // banner | interstitial | native | rewarded
  platform     String   @default("all") // ios | android | all
  screen       String   // which screen to show on
  position     String   @default("bottom") // top | bottom | inline | after_item
  adUnitIos    String?  // AdMob unit ID for iOS
  adUnitAndroid String? // AdMob unit ID for Android
  enabled      Boolean  @default(true)
  frequency    Int      @default(1) // show every N visits / items
  adFreeSkip   Boolean  @default(true) // skip for ad-free users
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([screen, enabled])
  @@map("ad_placements")
}

model Enquiry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  name        String
  email       String
  phone       String?
  topic       String   // Feedback | Complaints | Suggestions | General
  message     String
  attachments Json     @default("[]") // array of file URLs
  status      String   @default("open") // open | in_progress | resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("enquiries")
}
